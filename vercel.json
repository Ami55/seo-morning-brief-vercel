{
  "version": 2,
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-brief",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/daily-brief",
      "schedule": "0 18 * * *"
    }
  ]
}
